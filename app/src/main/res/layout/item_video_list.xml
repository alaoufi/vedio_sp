<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#20000000"
                android:contentDescription="@string/cd_thumbnail"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_video_placeholder" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@color/scrim"
                android:paddingHorizontal="5dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                tools:text="3:24" />

            <ImageView
                android:id="@+id/lockIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/white"
                android:background="@color/scrim"
                android:padding="2dp"
                android:contentDescription="@string/cd_lock"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/linkBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:src="@drawable/ic_link"
                app:tint="@color/white"
                android:background="@color/scrim"
                android:padding="2dp"
                android:contentDescription="@string/link_badge"
                android:visibility="gone" />

            <View
                android:id="@+id/selectionOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/selection_overlay"
                android:visibility="gone" />

            <!-- Resume progress: how far this clip has been watched. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/watchProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:max="1000"
                android:visibility="gone"
                app:trackCornerRadius="0dp"
                app:trackThickness="3dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="#33000000" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Sample video title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="1080p" />

                <TextView
                    android:id="@+id/size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="42.1 MB" />
            </LinearLayout>

            <TextView
                android:id="@+id/category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Music"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:id="@+id/favoriteIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="2dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="@string/cd_favorite" />

        <ImageButton
            android:id="@+id/menuButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/more_options" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
