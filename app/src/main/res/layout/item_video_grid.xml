<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="#20000000"
                android:contentDescription="@string/cd_thumbnail"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_video_placeholder" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@color/scrim"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:text="3:24" />

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:padding="3dp"
                android:background="@drawable/bg_control_scrim"
                android:src="@drawable/ic_favorite"
                android:contentDescription="@string/cd_favorite"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/lockIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/white"
                android:background="@drawable/bg_control_scrim"
                android:padding="3dp"
                android:contentDescription="@string/cd_lock"
                android:visibility="gone" />

            <!-- Shown for saved links (streamed, not downloaded). -->
            <ImageView
                android:id="@+id/linkBadge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:src="@drawable/ic_link"
                app:tint="@color/white"
                android:background="@drawable/bg_control_scrim"
                android:padding="3dp"
                android:contentDescription="@string/link_badge"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:background="@drawable/bg_control_scrim"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white"
                android:contentDescription="@string/more_options" />

            <View
                android:id="@+id/selectionOverlay"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@color/selection_overlay"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Title on its own full-width line below the thumbnail. -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Sample video title" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
