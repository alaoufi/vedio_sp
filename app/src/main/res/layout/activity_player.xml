<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_subtitle_button="true"
        app:use_controller="true" />

    <!-- Cover art shown for audio-only tracks (no video frame to display). -->
    <ImageView
        android:id="@+id/audioArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@string/type_audio"
        tools:visibility="visible" />

    <!-- Custom top bar. Hidden while controls are locked. -->
    <LinearLayout
        android:id="@+id/controlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/scrim"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:fitsSystemWindows="true">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Sample video" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speedButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textColor="@color/white"
            tools:text="1.00×" />

        <ImageButton
            android:id="@+id/backgroundToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_headphones"
            android:contentDescription="@string/cd_background" />

        <ImageButton
            android:id="@+id/pipButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pip"
            android:contentDescription="@string/cd_pip" />

        <ImageButton
            android:id="@+id/resizeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_aspect_ratio"
            app:tint="@color/white"
            android:contentDescription="@string/cd_resize" />

        <ImageButton
            android:id="@+id/rotateButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_screen_rotation"
            android:contentDescription="@string/cd_rotate" />
    </LinearLayout>

    <!-- Always-visible lock toggle so the user can unlock again. -->
    <ImageButton
        android:id="@+id/lockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_lock_open"
        android:contentDescription="@string/cd_lock" />

    <TextView
        android:id="@+id/gestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scrim"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/white"
        android:visibility="gone"
        tools:text="Brightness 60%" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textColor="@color/white"
        android:visibility="gone"
        tools:text="Unable to play this video" />

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

</FrameLayout>
