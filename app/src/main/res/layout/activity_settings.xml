<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- Appearance -->
            <TextView style="@style/SettingsHeader" android:text="@string/section_appearance" />

            <LinearLayout android:id="@+id/themeRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/theme" />
                    <TextView android:id="@+id/themeValue" style="@style/SettingsSubtitle"
                        tools:text="System" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/languageRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/language" />
                    <TextView android:id="@+id/languageValue" style="@style/SettingsSubtitle"
                        tools:text="العربية" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/endActionRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/end_of_clip" />
                    <TextView android:id="@+id/endActionValue" style="@style/SettingsSubtitle"
                        tools:text="Play next" />
                </LinearLayout>
            </LinearLayout>

            <!-- Downloads -->
            <TextView style="@style/SettingsHeader" android:text="@string/section_downloads" />

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/wifi_only" />
                    <TextView style="@style/SettingsSubtitle" android:text="@string/wifi_only_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wifiOnlySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/maxConcurrentRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/max_concurrent" />
                </LinearLayout>
                <TextView android:id="@+id/maxConcurrentValue" style="@style/SettingsValue"
                    tools:text="2" />
            </LinearLayout>

            <LinearLayout android:id="@+id/saveLocationRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/save_location" />
                    <TextView android:id="@+id/saveLocationValue" style="@style/SettingsSubtitle"
                        tools:text="Downloads" />
                </LinearLayout>
            </LinearLayout>

            <!-- Security -->
            <TextView style="@style/SettingsHeader" android:text="@string/section_security" />

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/app_lock" />
                    <TextView style="@style/SettingsSubtitle" android:text="@string/app_lock_desc" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/appLockSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/changePinRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/change_pin" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/biometric" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/biometricSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/prevent_screenshots" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/screenshotsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/hide_recents" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/recentsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Storage & backup -->
            <TextView style="@style/SettingsHeader" android:text="@string/section_storage" />

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/storage_used" />
                </LinearLayout>
                <TextView android:id="@+id/storageValue" style="@style/SettingsValue"
                    tools:text="1.4 GB" />
            </LinearLayout>

            <LinearLayout android:id="@+id/clearCacheRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/clear_cache" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/backupRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/backup" />
                    <TextView style="@style/SettingsSubtitle" android:text="@string/backup_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/restoreRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/restore" />
                </LinearLayout>
            </LinearLayout>

            <!-- About -->
            <TextView style="@style/SettingsHeader" android:text="@string/section_about" />

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/license_status" />
                    <TextView android:id="@+id/licenseValue" style="@style/SettingsSubtitle"
                        tools:text="Trial · 8 days left" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/guideRow" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/user_guide" />
                    <TextView style="@style/SettingsSubtitle" android:text="@string/user_guide_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsTitle" android:text="@string/version" />
                    <TextView android:id="@+id/versionValue" style="@style/SettingsSubtitle"
                        tools:text="1.0.0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
